rules_version = '2';
// Velocenter Homepage – Regeln für Cloud Firestore (in der Firebase-Konsole unter Firestore → Regeln einfügen → Veröffentlichen).
// Besucher dürfen nur lesen, was auf der Homepage steht. Schreiben nur die freigeschalteten Admin-Konten.
// Neues Admin-Konto: in Authentication anlegen (Benutzer@admin.velo-center.de) UND hier in die Liste eintragen.
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email in [
        'kevin@admin.velo-center.de',
        'stefan@admin.velo-center.de',
        'martina@admin.velo-center.de'
      ];
    }
    match /pub/{d}     { allow read: if true; allow write: if admin(); }
    match /bestand/{d} { allow read: if true; allow write: if admin(); }
    match /fotos/{d}   { allow read: if true; allow write: if admin(); }
    match /site/{d}    { allow read: if d in ['einstellungen', 'bewertungen', 'texte'] || admin(); allow write: if admin(); }
    match /lager/{d}   { allow read, write: if admin(); }
    // Besucher-Statistik (anonym, ohne Cookies): je Tag ein Dokument mit Zählern. Besucher dürfen nur hochzählen, lesen nur Admins.
    match /stats/{d} {
      allow read, delete: if admin();
      allow create, update: if d.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.size() <= 700
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().size() <= 40;
    }
    // Admin-Chat „Claude“: Aufträge schreiben die Admins, der GitHub-Lauf meldet sich mit dem Bot-Konto und trägt nur Status + Antwort ein.
    function bot() { return request.auth != null && request.auth.token.email == 'claude@admin.velo-center.de'; }
    match /claude/{d} {
      allow read: if admin() || bot();
      allow create, delete: if admin();
      allow update: if admin() || (bot() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'schritt', 'antwort', 'commit', 'run', 'start', 'fertig']));
    }
    // Zugang zum Start-Knopf (GitHub-Token nur mit „Actions: write“) – nur Admins.
    match /geheim/{d}  { allow read, write: if admin(); }
    match /{other=**}  { allow read, write: if false; }
  }
}
